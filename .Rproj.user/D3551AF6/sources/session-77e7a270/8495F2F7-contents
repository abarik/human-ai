/*-- scss:defaults --*/

$body-bg: #1e2024;
$body-color: #d8dadd;

$link-color: #8eb8dc;
$link-hover-color: #b5d2ea;

$navbar-bg: #25282d;
$navbar-fg: #e8e9eb;
$navbar-hl: #ffffff;

$card-bg: #25282d;
$border-color: #3b3f45;

$code-block-bg: #181a1d;
